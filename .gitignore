/releases/*.exe
/releases/*.log
/releases/logs/
/releases/shares.json
/releases/config.json

# But include prebuilt client binaries
!/releases/built/

# Runtime configuration/logs
/config.json
/certs/
/logs
/server.log

# Server release binaries
/releases/*
!/releases/built/
!/releases/built/**
/built

# Tooling/build caches
/tools
node_modules/
dist/

# Playwright artifacts (E2E)
/web/.playwright/
/web/test-results/
/web/playwright-report/
/web/logs/

# Local handler logs created during dev/E2E
/server/handler/*/logs/

.DS_Store
/.idea
