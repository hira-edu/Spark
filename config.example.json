{
  "listen": ":8443",
  "salt": "your-salt-here-max-24-chars",
  "auth": {
    "admin": "your-password-here"
  },
  "log": {
    "level": "info",
    "path": "./logs",
    "days": 7
  },
  "tls": {
    "enable": true,
    "cert": "./certs/server.crt",
    "key": "./certs/server.key",
    "autocert": {
      "enable": false,
      "domains": ["yourdomain.com"],
      "email": "admin@yourdomain.com",
      "cache_dir": "./certs"
    }
  },
  "mongodb": {
    "enable": true,
    "uri": "mongodb://localhost:27017",
    "database": "rocket"
  },
  "cluster": {
    "enable": true,
    "public_url": "https://controller.example.com",
    "controller_id_file": "./data/controller.id",
    "lease_ttl_seconds": 120,
    "session_lease_seconds": 180,
    "stale_after_seconds": 90,
    "cleanup_interval_seconds": 30,
    "use_change_streams": true
  },
  "desktop": {
    "capture": {
      "mode": "auto",
      "enable_pre_dwm": false,
      "fallback_order": [
        "sharedSurface",
        "nvfbc",
        "dxgi",
        "gdi"
      ],
      "adapter_luid": ""
    }
  },
  "webrtc": {
    "turn_servers": [],
    "stun_servers": [
      "stun:stun.l.google.com:19302"
    ]
  },
  "transport": {
    "long_polling": {
      "enable": true
    },
    "quic": {
      "enable": true,
      "listen": ":443"
    },
    "dns": {
      "enable": false,
      "listen": ":53",
      "domain": "c2.example.com"
    }
  },
  "p2p": {
    "enable": false,
    "rendezvous_url": "",
    "target": "",
    "stun_servers": [
      "stun:stun.l.google.com:19302"
    ]
  }
}
